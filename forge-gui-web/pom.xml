<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>forge</artifactId>
        <groupId>forge</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>forge-gui-web</artifactId>
    <packaging>jar</packaging>
    <name>Forge Web GUI</name>

    <properties>
        <!-- Read by the npm test run below; -DskipTests on the command line overrides it -->
        <skipTests>false</skipTests>
    </properties>

    <dependencies>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>forge-gui-web</finalName>
        <plugins>
            <!-- Dates a snapshot's version as desktop's and Android's builds do, for the jar's manifest -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>timestamp-property</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>timestamp-property</goal>
                        </goals>
                        <configuration>
                            <name>month.date</name>
                            <pattern>MM.dd</pattern>
                        </configuration>
                    </execution>
                    <execution>
                        <id>regex-property</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>regex-property</goal>
                        </goals>
                        <configuration>
                            <name>snapshot-version</name>
                            <value>${revision}</value>
                            <regex>-SNAPSHOT</regex>
                            <replacement>-SNAPSHOT-${month.date}</replacement>
                            <failIfNoMatch>false</failIfNoMatch>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Writes src/main/ts/protocol.gen.ts from the protocol's Java records once they compile, and
                 src/main/ts/text.gen.ts from the language keys the TypeScript uses, for the TypeScript type check
                 below. It is declared first so it runs before that check in the same phase. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>protocol-types</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>forge.web.protocol.ProtocolTypes</mainClass>
                            <arguments>
                                <argument>${project.basedir}/src/main/ts/protocol.gen.ts</argument>
                                <argument>${project.basedir}/../forge-gui/res/languages/</argument>
                                <argument>${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The tests save quests, conquests and preferences, so they get a Forge profile of their own rather than
                 the developer's: user.home on Linux and macOS, APPDATA and LOCALAPPDATA on Windows. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <user.home>${project.build.directory}/test-home</user.home>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <APPDATA>${project.build.directory}/test-home</APPDATA>
                        <LOCALAPPDATA>${project.build.directory}/test-home</LOCALAPPDATA>
                    </environmentVariables>
                </configuration>
            </plugin>
            <!-- Compiles the browser client (src/main/ts) into web/js/app.js. Node is downloaded into ./node, so a
                 build needs nothing installed beyond Maven. -Dskip.npm -Dskip.installnodenpm leaves the last
                 bundle in place. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <nodeVersion>v22.22.2</nodeVersion>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <!-- A package already in npm's cache is used without asking the registry, and no audit or funding check is made -->
                            <arguments>ci --prefer-offline --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-typecheck</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run typecheck</arguments>
                        </configuration>
                    </execution>
                    <!-- The browser client's own tests, alongside the Java ones; -DskipTests skips both -->
                    <execution>
                        <id>npm-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>test</arguments>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>forge.web.WebMain</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                        <!-- Quest's saves are read by XStream, which needs these, as desktop's jar declares them -->
                        <manifestEntries>
                            <Implementation-Version>${snapshot-version}</Implementation-Version>
                            <Add-Opens>java.base/java.util java.base/java.lang java.base/java.lang.reflect java.base/java.text java.base/java.math java.base/java.util.concurrent java.base/java.net java.base/java.nio</Add-Opens>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
